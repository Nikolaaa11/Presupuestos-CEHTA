# Base de datos — dev local: npm run db:dev y copiá la URL que imprime (puerto 51214)
# Producción: URL de Neon/Supabase Postgres
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:51214/presupuestos?sslmode=disable"

# Auth.js — generá uno propio: npx auth secret
AUTH_SECRET="cambiar-por-un-secreto-real"
AUTH_TRUST_HOST="true"
