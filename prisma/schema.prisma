// Presupuestos CEHTA — modelo de datos
// Regla de oro: toda cifra monetaria es Decimal (jamás Float).
// Los presupuestos APROBADO/CERRADO son inmutables a nivel de API.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Entidades ───────────────────────────────

enum CompanyType {
  ADMINISTRADORA // AFIS
  FONDO          // FIP CEHTA ESG
  PORTFOLIO      // las 6 portfolio companies + CENERGY
}

model Company {
  id         String      @id @default(cuid())
  code       String      @unique // AFIS, FIP, CENERGY, CSL, RHO, DTE, EVOQUE, REVTECH, TRONGKAI, PANIMAVIDA
  name       String
  rut        String? // necesario para la nómina bancaria de transferencias
  /**
   * Cuenta corriente Santander desde la que la empresa paga: la columna
   * "Cuenta origen" del formato de transferencias masivas del banco.
   * Se configura en /configuracion; si falta, la nómina deja la celda vacía.
   */
  cuentaOrigen String?
  type       CompanyType
  sector     String?
  users      User[]
  budgets    Budget[]
  bankSheets BankSheet[]
  transferBatches TransferBatch[]
  bankEvents      BankEvent[]
  dropboxCarpetas DropboxCarpeta[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  FUND_ADMIN      // AFIS/FIP: ve todo, aprueba, administra
  COMPANY_MANAGER // gerente: edita el presupuesto de SU empresa
  DUENO           // Guido: libera pagos y confirma que se transfirieron
  ADMINISTRADORA  // Vicky: sube el comprobante de transferencia del lote
  FUND_ANALYST    // fase 2: analista del fondo (solo lectura ampliada)
  VIEWER          // fase 2
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  active       Boolean  @default(true)

  approvalEvents ApprovalEvent[]
  fxRatesUpdated FxRate[]
  bankSheetsUploaded BankSheet[]
  bankMovementsReleased BankMovement[]
  bankMovementsCreated  BankMovement[] @relation("MovimientoCreadoPor")
  dropboxConexiones     DropboxConnection[]
  batchesReleased    TransferBatch[] @relation("BatchReleasedBy")
  batchesProofed     TransferBatch[] @relation("BatchProofBy")
  batchesTransferred TransferBatch[] @relation("BatchTransferredBy")
  bankEvents         BankEvent[]
  expenseLinesPaid   ExpenseLine[]       @relation("ExpenseLinePaidBy")
  capexStagesPaid    CapexPaymentStage[] @relation("CapexStagePaidBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────── Presupuesto ───────────────────────────────

/**
 * Ciclo del presupuesto, en paralelo al circuito de pagos:
 *   BORRADOR ─envía→ ENVIADO ─revisa→ REVISADO ─aprueba→ APROBADO
 *                      (encargado)   (Victoria)          (Guido)
 * Cualquiera de los dos puede OBSERVAR y devolverlo a edición.
 */
enum BudgetStatus {
  BORRADOR
  ENVIADO
  REVISADO // Victoria (administradora) dio el visto bueno; falta la aprobación del dueño
  OBSERVADO
  APROBADO
  CERRADO
}

enum Currency {
  CLP
  UF
  USD
}

model Budget {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year      Int // año presupuestado (ej. 2027)
  version   Int          @default(1)
  status    BudgetStatus @default(BORRADOR)
  currency  Currency     @default(CLP)

  salesLines   SalesLine[]
  expenseLines ExpenseLine[]
  capexItems   CapexItem[]
  approvals    ApprovalEvent[]

  submittedAt DateTime?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, year, version])
  @@index([companyId, year])
}

// ─────────────────────────────── Ventas ───────────────────────────────

enum SaleType {
  CONTRATO           // venta respaldada por contrato
  PROYECCION_PUBLICO // proyección de venta a público
  RECURRENTE         // cartera existente
}

model SalesLine {
  id       String   @id @default(cuid())
  budgetId String
  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  client   String
  saleType SaleType @default(PROYECCION_PUBLICO)
  channel  String? // cómo se vende

  capexItemId String? // vínculo a iniciativa CAPEX (ej. "Local Pargua")
  capexItem   CapexItem? @relation(fields: [capexItemId], references: [id], onDelete: SetNull)

  m01 Decimal @default(0) @db.Decimal(18, 2)
  m02 Decimal @default(0) @db.Decimal(18, 2)
  m03 Decimal @default(0) @db.Decimal(18, 2)
  m04 Decimal @default(0) @db.Decimal(18, 2)
  m05 Decimal @default(0) @db.Decimal(18, 2)
  m06 Decimal @default(0) @db.Decimal(18, 2)
  m07 Decimal @default(0) @db.Decimal(18, 2)
  m08 Decimal @default(0) @db.Decimal(18, 2)
  m09 Decimal @default(0) @db.Decimal(18, 2)
  m10 Decimal @default(0) @db.Decimal(18, 2)
  m11 Decimal @default(0) @db.Decimal(18, 2)
  m12 Decimal @default(0) @db.Decimal(18, 2)

  // Ejecución real (los Excel del fondo traen PROYECTADO vs REAL por mes).
  // m01-m12 = presupuestado · r01-r12 = ejecutado.
  r01 Decimal @default(0) @db.Decimal(18, 2)
  r02 Decimal @default(0) @db.Decimal(18, 2)
  r03 Decimal @default(0) @db.Decimal(18, 2)
  r04 Decimal @default(0) @db.Decimal(18, 2)
  r05 Decimal @default(0) @db.Decimal(18, 2)
  r06 Decimal @default(0) @db.Decimal(18, 2)
  r07 Decimal @default(0) @db.Decimal(18, 2)
  r08 Decimal @default(0) @db.Decimal(18, 2)
  r09 Decimal @default(0) @db.Decimal(18, 2)
  r10 Decimal @default(0) @db.Decimal(18, 2)
  r11 Decimal @default(0) @db.Decimal(18, 2)
  r12 Decimal @default(0) @db.Decimal(18, 2)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([budgetId])
  // El caso bancable consulta las líneas por iniciativa; sin este índice
  // Postgres hace scan secuencial (las FK no se indexan solas).
  @@index([capexItemId])
}

// ─────────────────────────────── Gastos ───────────────────────────────

model ExpenseCategory {
  id        String        @id @default(cuid())
  name      String        @unique
  isSystem  Boolean       @default(false) // las de semilla no se borran
  sortOrder Int           @default(0)
  lines     ExpenseLine[]
}

model ExpenseLine {
  id         String          @id @default(cuid())
  budgetId   String
  budget     Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  item       String // ej. "Sueldos planta", "Arriendo oficina"

  capexItemId String?
  capexItem   CapexItem? @relation(fields: [capexItemId], references: [id], onDelete: SetNull)

  m01 Decimal @default(0) @db.Decimal(18, 2)
  m02 Decimal @default(0) @db.Decimal(18, 2)
  m03 Decimal @default(0) @db.Decimal(18, 2)
  m04 Decimal @default(0) @db.Decimal(18, 2)
  m05 Decimal @default(0) @db.Decimal(18, 2)
  m06 Decimal @default(0) @db.Decimal(18, 2)
  m07 Decimal @default(0) @db.Decimal(18, 2)
  m08 Decimal @default(0) @db.Decimal(18, 2)
  m09 Decimal @default(0) @db.Decimal(18, 2)
  m10 Decimal @default(0) @db.Decimal(18, 2)
  m11 Decimal @default(0) @db.Decimal(18, 2)
  m12 Decimal @default(0) @db.Decimal(18, 2)

  // Ejecución real (los Excel del fondo traen PROYECTADO vs REAL por mes).
  // m01-m12 = presupuestado · r01-r12 = ejecutado.
  r01 Decimal @default(0) @db.Decimal(18, 2)
  r02 Decimal @default(0) @db.Decimal(18, 2)
  r03 Decimal @default(0) @db.Decimal(18, 2)
  r04 Decimal @default(0) @db.Decimal(18, 2)
  r05 Decimal @default(0) @db.Decimal(18, 2)
  r06 Decimal @default(0) @db.Decimal(18, 2)
  r07 Decimal @default(0) @db.Decimal(18, 2)
  r08 Decimal @default(0) @db.Decimal(18, 2)
  r09 Decimal @default(0) @db.Decimal(18, 2)
  r10 Decimal @default(0) @db.Decimal(18, 2)
  r11 Decimal @default(0) @db.Decimal(18, 2)
  r12 Decimal @default(0) @db.Decimal(18, 2)

  // Marcado manual de "ya se pagó" — informativo, no depende de un cruce
  // automático con Bancos (no hay una clave de unión confiable entre ambos:
  // ni RUT ni número de orden compartido). El módulo puede SUGERIR un cruce
  // por monto, pero solo una persona confirma el marcado.
  paid     Boolean   @default(false)
  paidAt   DateTime?
  paidById String?
  paidBy   User?     @relation("ExpenseLinePaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([budgetId])
  @@index([capexItemId]) // caso bancable: gastos de la iniciativa
  @@index([categoryId])  // conteo por categoría y verificación de la FK al borrar
}

// ─────────────────────────────── CAPEX ───────────────────────────────

enum FinancingSource {
  CAJA_PROPIA
  BANCO
  FONDO
  LEASING
  MIXTO
}

enum ApprovalStatus {
  BORRADOR
  ENVIADO
  APROBADO
  OBSERVADO
  RECHAZADO
}

model CapexItem {
  id          String  @id @default(cuid())
  budgetId    String
  budget      Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  description String // qué se compra/construye
  purpose     String? // para qué

  amount   Decimal  @db.Decimal(18, 2)
  currency Currency @default(CLP)

  monthNeeded     Int // 1..12 — mes en que se requiere la inversión
  financingMonths Int? // plazo de financiamiento (ej. 18)
  financingSource FinancingSource @default(CAJA_PROPIA)

  isInitiative   Boolean @default(false)
  initiativeName String? // ej. "Local Pargua"

  // Gobernanza: nivel N1–N6 calculado por umbral en UF (server-side)
  approvalLevel  Int? // 1..6
  approvalStatus ApprovalStatus @default(BORRADOR)

  salesLines     SalesLine[] // ventas vinculadas a la iniciativa
  expenseLines   ExpenseLine[] // gastos vinculados a la iniciativa
  approvals      ApprovalEvent[]
  paymentStages  CapexPaymentStage[] // cronograma de desembolso por etapas (%)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([budgetId])
}

/**
 * Cronograma de pago de una inversión, en porcentaje del monto total en vez
 * de cuotas mensuales iguales — ej. 30% al pedido, 70% contra entrega. Es
 * información aparte de `financingMonths`/"cuota mensual estimada" del caso
 * bancable: esa cifra sigue siendo la referencial para pitchear al banco:
 * esto es la planificación interna de cuándo desembolsar cada parte.
 */
model CapexPaymentStage {
  id          String    @id @default(cuid())
  capexItemId String
  capexItem   CapexItem @relation(fields: [capexItemId], references: [id], onDelete: Cascade)

  label    String // "Anticipo", "Contra entrega", "Final"...
  percent  Decimal @db.Decimal(5, 2) // 0-100, del monto total del ítem
  dueMonth Int // 1..12, mes del año del presupuesto en que vence esta etapa

  paid     Boolean   @default(false)
  paidAt   DateTime?
  paidById String?
  paidBy   User?     @relation("CapexStagePaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([capexItemId])
}

// ─────────────────────────────── Auditoría y parámetros ───────────────────────────────

enum ApprovalAction {
  ENVIADO
  REVISADO
  OBSERVADO
  APROBADO
  RECHAZADO
  REABIERTO
  CERRADO
}

model ApprovalEvent {
  id          String         @id @default(cuid())
  budgetId    String
  budget      Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  capexItemId String? // si el evento es sobre un ítem CAPEX puntual
  capexItem   CapexItem?     @relation(fields: [capexItemId], references: [id], onDelete: SetNull)
  actorUserId String
  actor       User           @relation(fields: [actorUserId], references: [id])
  action      ApprovalAction
  comment     String?
  createdAt   DateTime       @default(now())

  @@index([budgetId, createdAt])
}

// ─────────────────────────────── Bancos / Tesorería ───────────────────────────────

/** Una planilla bancaria subida o importada (cartola, detalle de transferencias). */
model BankSheet {
  id           String  @id @default(cuid())
  companyId    String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String // ej. "CC Santander", "AFIS"
  sourceFile   String // archivo de origen, ej. "CC Bancos VA 25.06.2026 (1).xlsx"
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  /**
   * Planilla de cargas hechas a mano desde la app, no importadas de un Excel.
   * Es una COLUMNA y no una convención de nombre a propósito: en este módulo el
   * nombre no es una llave — la subida reemplaza planillas con
   * `deleteMany({ name })` y `esPlanillaRegistroOC` clasifica por nombre. Apoyar
   * la regla en el nombre dejaba abierta la puerta de que un Excel con una hoja
   * llamada igual borrara en cascada todo lo cargado a mano, que es lo único
   * que no se puede volver a importar de ningún lado.
   */
  manual Boolean @default(false)

  movements BankMovement[]

  createdAt DateTime @default(now())

  @@unique([companyId, name])
  @@index([companyId])
}

/** Un movimiento/transferencia de la planilla. `released` = liberado con el botón. */
model BankMovement {
  id       String    @id @default(cuid())
  sheetId  String
  sheet    BankSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  rowIndex Int // orden original en la planilla

  date        DateTime? // fecha (o fecha de pago)
  entryDate   DateTime? // fecha de ingreso (detalle de transferencias)
  reference   String? // Nombre/Ref, N° OC o Proveedor
  description String?

  credit  Decimal  @default(0) @db.Decimal(18, 2) // Abonos
  debit   Decimal  @default(0) @db.Decimal(18, 2) // Egresos / monto a pagar
  balance Decimal? @db.Decimal(18, 2) // Saldo si la planilla lo trae

  categoryGeneral  String? // General
  categoryDetail   String? // Detallado
  categorySpecific String? // Específico
  businessCenter   String? // Centro Negocios
  capitalTag       String? // Aporte K

  rut           String?
  bankName      String?
  accountNumber String?
  accountType   String?
  docType       String?
  docNumber     String?
  email         String?
  link          String?

  released     Boolean   @default(false)
  releasedAt   DateTime?
  releasedById String?
  releasedBy   User?     @relation(fields: [releasedById], references: [id], onDelete: SetNull)

  /**
   * Quién lo creó a mano (null = vino de una planilla importada). Sin este dato
   * no existe la columna contra la cual comparar para el guard de cuatro ojos:
   * quien origina un pago no puede ser quien lo libera.
   */
  createdById String?
  createdBy   User?   @relation("MovimientoCreadoPor", fields: [createdById], references: [id], onDelete: SetNull)

  /**
   * Circuito de pagos (mandato del directorio):
   * PENDIENTE → LIBERADO (dueño) → EN_TRANSFERENCIA (administradora sube el
   * comprobante) → TRANSFERIDO (dueño confirma). `released` se mantiene en
   * sincronía para no romper lo existente: es true desde LIBERADO en adelante.
   */
  estado  MovementStatus @default(PENDIENTE)
  batchId String?
  batch   TransferBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  events BankEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([sheetId])
  @@index([sheetId, released])
  @@index([batchId])
  @@index([sheetId, estado])
}

// ───────────────────── Lotes de transferencia y bitácora ─────────────────────

enum MovementStatus {
  PENDIENTE
  LIBERADO
  EN_TRANSFERENCIA
  TRANSFERIDO
}

enum BatchStatus {
  LIBERADO          // el dueño autorizó los pagos
  COMPROBANTE_SUBIDO // la administradora adjuntó la transferencia
  TRANSFERIDO       // el dueño confirmó que la plata salió
}

/**
 * Agrupa todos los pagos que el dueño liberó de una vez. Es la unidad de
 * trabajo de la administradora: un comprobante y una confirmación por lote.
 * De acá sale el Excel de nómina bancaria para la carga masiva.
 */
model TransferBatch {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number    Int // correlativo por empresa: LOTE-001, LOTE-002…

  status BatchStatus @default(LIBERADO)
  note   String?

  releasedById String?
  releasedBy   User?    @relation("BatchReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)
  releasedAt   DateTime @default(now())

  proofFileName   String?
  proofUploadedAt DateTime?
  proofUploadedById String?
  proofUploadedBy   User?  @relation("BatchProofBy", fields: [proofUploadedById], references: [id], onDelete: SetNull)

  transferredAt   DateTime?
  transferredById String?
  transferredBy   User?     @relation("BatchTransferredBy", fields: [transferredById], references: [id], onDelete: SetNull)

  movements BankMovement[]
  events    BankEvent[]

  createdAt DateTime @default(now())

  @@unique([companyId, number])
  @@index([companyId, status])
}

/**
 * Conexión con Dropbox. Hay UNA sola en toda la plataforma (la cuenta del
 * fondo), por eso la fila se fija con id = "unica": evita que dos
 * conexiones simultáneas dejen la app apuntando a cuentas distintas.
 *
 * El refresh token abre TODA la carpeta financiera del grupo, así que no se
 * guarda en claro: viaja cifrado con AES-256-GCM (ver src/lib/cripto.ts). Un
 * volcado de la base no alcanza para entrar a Dropbox.
 */
model DropboxConnection {
  id String @id @default("unica")

  /** Cifrado. Nunca sale del servidor ni se muestra en pantalla. */
  refreshTokenCifrado String
  /** Alcance concedido, para detectar que faltan permisos sin tener que fallar. */
  scopes String?

  /** Con qué cuenta quedó conectada, para mostrarlo. */
  cuentaNombre String?
  cuentaEmail  String?
  /** Dropbox Business: los archivos del equipo viven en otro espacio. */
  esEquipo         Boolean @default(false)
  rootNamespaceId  String?

  /** Carpeta raíz que se sincroniza, tal como la nombra Dropbox. */
  carpetaRaiz String?
  /** Cursor de list_folder: con esto se pregunta "¿qué cambió?" sin releer todo. */
  cursor String?

  conectadoPorId String?
  conectadoPor   User?    @relation(fields: [conectadoPorId], references: [id], onDelete: SetNull)
  conectadoEl    DateTime @default(now())
  ultimaMiradaEl DateTime?

  carpetas DropboxCarpeta[]

  updatedAt DateTime @updatedAt
}

/**
 * Qué carpeta de Dropbox corresponde a qué empresa. Es un mapeo explícito y
 * editable: adivinarlo por el nombre fallaría con «09_Consulting & Energy
 * Ltda» → CENERGY, y una carpeta mapeada a la empresa equivocada mete los
 * movimientos de una entidad en otra.
 */
model DropboxCarpeta {
  id           String            @id @default(cuid())
  conexionId   String
  conexion     DropboxConnection @relation(fields: [conexionId], references: [id], onDelete: Cascade)

  /** Ruta relativa a la carpeta raíz, ej. "/01_Administradora de Fondos". */
  ruta String

  /** Null = carpeta reconocida pero sin empresa: se ignora y se dice. */
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conexionId, ruta])
  @@index([companyId])
}

enum BankAction {
  LIBERADO
  LIBERACION_DESHECHA
  COMPROBANTE_SUBIDO
  TRANSFERIDO
  TRANSFERENCIA_REVERTIDA
  MOVIMIENTO_AGREGADO
  MOVIMIENTO_EDITADO
  PLANILLA_IMPORTADA
  PLANILLA_ELIMINADA
}

/**
 * Bitácora del módulo Bancos: append-only. Nunca se actualiza ni se borra;
 * es la prueba de quién autorizó y quién movió cada peso.
 */
model BankEvent {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /**
   * SetNull y no Cascade: la bitácora es append-only y tiene que sobrevivir a
   * lo que documenta. Con Cascade se borraba sola — `deshacerLiberacion`
   * escribía LIBERACION_DESHECHA con el batchId y en la línea siguiente borraba
   * el lote, llevándose el evento recién escrito y todos los LIBERADO de ese
   * lote. El `detail` de cada evento se escribe autosuficiente justamente para
   * que siga contando la historia cuando la fila que lo originó ya no está.
   */
  movementId  String?
  movement    BankMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)
  batchId     String?
  batch       TransferBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  actorUserId String?
  actor       User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      BankAction
  detail      String? // ej. "monto: 350.000 → 380.000"
  createdAt   DateTime   @default(now())

  @@index([companyId, createdAt])
  @@index([movementId])
  @@index([batchId])
}

model FxRate {
  id          String  @id @default(cuid())
  year        Int     @unique
  ufToClp     Decimal @db.Decimal(12, 2) // ej. 39200.00
  usdToClp    Decimal @db.Decimal(10, 2) // ej. 950.00
  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt
}
